{
  QLS_GenerateGroups.pas
  ----------------------
  Generates FormID-keyed grouping rules for QuestLogSorter from whatever is
  loaded in FO4Edit.

  Why this exists: EditorIDs are visible here but usually stripped from the
  release runtime, so the plugin cannot match "BoS101" at load time. This walks
  every QUST record, applies the same prefix rules you would write by hand, and
  writes out a byForm table the plugin can use without EditorIDs.

  Usage
    1. Open FO4Edit with your full load order.
    2. Right-click any plugin > Apply Script > QLS_GenerateGroups.
    3. Output lands in Data\F4SE\Plugins\QuestLogSorter\groups.generated.json.
    4. Either rename it to groups.json, or paste its "byForm" block into your
       existing groups.json so you keep your hand-written sections and order.

  Re-run it whenever you add a mod that ships quests.
}
unit QLS_GenerateGroups;

var
  Entries: TStringList;   // "file|FORMID|line"
  Prefixes: TStringList;  // "PREFIX=Line"
  Hidden: TStringList;
  SkippedNoName: Integer;
  SkippedHidden: Integer;

procedure AddPrefix(const APrefix, ALine: string);
begin
  Prefixes.Add(UpperCase(APrefix) + '=' + ALine);
end;

function Initialize: Integer;
begin
  Entries := TStringList.Create;
  Prefixes := TStringList.Create;
  Hidden := TStringList.Create;
  SkippedNoName := 0;
  SkippedHidden := 0;

  // Longest prefixes first - the matcher takes the first hit.
  AddPrefix('DLC01MQ', 'Main Story');
  AddPrefix('DLC03MQ', 'Main Story');
  AddPrefix('DLC04MQ', 'Main Story');
  AddPrefix('DLC06MQ', 'Main Story');
  AddPrefix('DLC03DN', 'Locations');
  AddPrefix('MinRecruit', 'Minutemen');
  AddPrefix('Minutemen', 'Minutemen');
  AddPrefix('Workshop', 'Settlement');
  AddPrefix('Radiant', 'Radiant');
  AddPrefix('DLC01', 'Side Quests');
  AddPrefix('DLC03', 'Side Quests');
  AddPrefix('DLC04', 'Side Quests');
  AddPrefix('DLC06', 'Side Quests');
  AddPrefix('Inst', 'Institute');
  AddPrefix('BoS', 'Brotherhood of Steel');
  AddPrefix('COM', 'Companion Quests');
  AddPrefix('Rel', 'Companion Quests');
  AddPrefix('V81', 'Vault 81');
  AddPrefix('WRK', 'Settlement');
  AddPrefix('Min', 'Minutemen');
  AddPrefix('MQ', 'Main Story');
  AddPrefix('RR', 'Railroad');
  AddPrefix('MS', 'Side Quests');
  AddPrefix('DN', 'Locations');
  AddPrefix('RE', 'Random Encounters');

  Hidden.Add('DIALOGUE');
  Hidden.Add('SCENE');
  Hidden.Add('TEST');
  Hidden.Add('DEBUG');
  Hidden.Add('ZZ');

  Result := 0;
end;

function StartsWithText(const AHaystack, ANeedle: string): Boolean;
begin
  Result := (Length(AHaystack) >= Length(ANeedle)) and
            (UpperCase(Copy(AHaystack, 1, Length(ANeedle))) = UpperCase(ANeedle));
end;

function IsHidden(const AEditorID: string): Boolean;
var
  i: Integer;
begin
  Result := False;
  for i := 0 to Pred(Hidden.Count) do
    if StartsWithText(AEditorID, Hidden[i]) then begin
      Result := True;
      Exit;
    end;
end;

function ResolveLine(const AEditorID: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to Pred(Prefixes.Count) do
    if StartsWithText(AEditorID, Prefixes.Names[i]) then begin
      Result := Prefixes.ValueFromIndex[i];
      Exit;
    end;
end;

function LocalFormID(e: IInterface): Cardinal;
var
  id: Cardinal;
begin
  id := GetLoadOrderFormID(e);
  if (id and $FF000000) = $FE000000 then
    Result := id and $00000FFF   // light plugin
  else
    Result := id and $00FFFFFF;
end;

function Process(e: IInterface): Integer;
var
  edid, line, name, fileName: string;
begin
  Result := 0;
  if Signature(e) <> 'QUST' then
    Exit;

  // Only the record that defines the quest, not every override.
  if not IsMaster(e) then
    Exit;

  edid := EditorID(e);
  name := GetElementEditValues(e, 'FULL');
  fileName := GetFileName(GetFile(e));

  if name = '' then begin
    Inc(SkippedNoName);
    Exit;
  end;

  if IsHidden(edid) then begin
    Inc(SkippedHidden);
    Exit;
  end;

  line := ResolveLine(edid);
  if line = '' then
    Exit;  // let the plugin fall back to byType at runtime

  Entries.Add(fileName + '|' + IntToHex(LocalFormID(e), 6) + '|' + line);
end;

function Finalize: Integer;
var
  out: TStringList;
  i, j: Integer;
  parts: TStringList;
  currentFile, thisFile: string;
  outPath: string;
begin
  Entries.Sort;

  out := TStringList.Create;
  parts := TStringList.Create;
  try
    out.Add('{');
    out.Add('  // Generated by QLS_GenerateGroups.pas - do not hand-edit.');
    out.Add('  // Paste this "byForm" block into groups.json under "lines".');
    out.Add('  "byForm": {');

    currentFile := '';
    for i := 0 to Pred(Entries.Count) do begin
      parts.Clear;
      parts.Delimiter := '|';
      parts.StrictDelimiter := True;
      parts.DelimitedText := Entries[i];
      if parts.Count < 3 then
        Continue;

      thisFile := parts[0];
      if thisFile <> currentFile then begin
        if currentFile <> '' then
          out.Add('    },');
        out.Add('    "' + thisFile + '": {');
        currentFile := thisFile;
      end else
        out[Pred(out.Count)] := out[Pred(out.Count)] + ',';

      out.Add('      "' + parts[1] + '": "' + parts[2] + '"');
    end;

    if currentFile <> '' then
      out.Add('    }');
    out.Add('  }');
    out.Add('}');

    outPath := DataPath + 'F4SE\Plugins\QuestLogSorter\';
    if not DirectoryExists(outPath) then
      ForceDirectories(outPath);

    out.SaveToFile(outPath + 'groups.generated.json');

    AddMessage('QuestLogSorter: wrote ' + IntToStr(Entries.Count) + ' rules to ' +
      outPath + 'groups.generated.json');
    AddMessage('  skipped (no name): ' + IntToStr(SkippedNoName));
    AddMessage('  skipped (hidden):  ' + IntToStr(SkippedHidden));
  finally
    parts.Free;
    out.Free;
  end;

  Entries.Free;
  Prefixes.Free;
  Hidden.Free;
  Result := 0;
end;

end.
